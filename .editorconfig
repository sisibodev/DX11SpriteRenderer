# EditorConfig — DX11SpriteRenderer
#
# 새로 만드는 파일도 자동으로 UTF-8로 저장되게 강제한다.
#
# C/C++는 BOM을 포함시킨다:
#   MSVC는 BOM이 없으면 파일을 시스템 코드페이지(한국어 Windows = CP949)로
#   해석해서 한글 주석이 깨지고 C4819 경고가 발생한다.
#
# 반대로 HLSL은 BOM을 넣으면 안 된다:
#   셰이더 컴파일러(FXC)가 BOM을 읽지 못해 error X3000: Illegal character 로 실패한다.

root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

# C/C++ 소스 — MSVC를 위해 BOM 필요
[*.{c,cpp,h,hpp}]
charset = utf-8-bom
indent_style = tab
indent_size = 4

# HLSL 셰이더 — FXC가 BOM을 처리 못 하므로 BOM 없이
[*.hlsl]
charset = utf-8
indent_style = tab
indent_size = 4

# 문서·설정 파일
[*.{md,json,yml,yaml,xml}]
charset = utf-8
indent_style = space
indent_size = 2